{
  "name": "@butler/sim-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Butler Black Box panel: an addon-sim panel plugin that live-tails the Butler debug API (receipts, policy decisions, rules).",
  "license": "MIT",
  "scripts": {
