{
  "name": "@butler/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Butler MCP Apps views: one self-contained HTML file per view",
  "scripts": {
    "build": "node build.mjs",
    "preview:fixtures": "node build.mjs && node preview/start.mjs",
    "screenshots": "node preview/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "preact": "^10.26.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@butler/contracts": "workspace:*",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0"
  }
}
