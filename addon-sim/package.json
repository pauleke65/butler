{
  "name": "addon-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source simulator for voice assistants that host MCP add-ons (MCP Apps host, tool-use brain, voice, inspector).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 3000",
    "dev:sandbox": "tsx sandbox/server.ts",
    "build": "next build",
    "start": "node scripts/dev.mjs --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "run-script": "tsx src/cli/run-script.ts",
    "play": "tsx src/cli/run-script.ts",
    "mock-server": "tsx test/mock-server/main.ts",
    "example-apps-server": "tsx test/example-apps-server/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@aws-sdk/client-polly": "^3.1146.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
